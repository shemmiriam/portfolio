{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build:static",
  "outputDirectory": "out",
  "installCommand": "npm install",
  "build": {
    "env": {
      "NODE_OPTIONS": "--openssl-legacy-provider"
    }
  },
  "headers": [
    {
      "source": "/files/resume.pdf",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment; filename=\"Miriam-Shem-CV.pdf\"" }
      ]
    }
  ]
}
